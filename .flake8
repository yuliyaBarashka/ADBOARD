[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    */migrations/*,
    venv,
    .venv,
    env,
    .env,
    htmlcov,
    .pytest_cache,
    staticfiles,
    media,
    node_modules
extend-ignore =
    E203,
    W503,
    E501
per-file-ignores =
    */settings.py: E501
    */tests.py: E501
max-complexity = 10
